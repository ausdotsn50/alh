---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  schema?: Record<string, unknown>[];
}

const { title, description, ogImage, schema } = Astro.props as Props;
---

<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* The owner's photo, cropped round like the Facebook page's profile
        picture, so the tab matches the page people arrive from. */}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Fonts: self-hosted (src/styles/fonts.css, imported above), no Google
        Fonts request. Preload only the three files the hero needs for
        first paint — wordmark (display), tagline (display italic), body
        copy — so text doesn't wait on a second render pass. The rest
        (latin-ext, needed for ₱ further down the page) load lazily. */}
    <link rel="preload" href="/fonts/fraunces-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    <SEO title={title} description={description} ogImage={ogImage} schema={schema} />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      /* Messenger and Facebook links carry target="_blank" so desktop
         opens them in a new tab. On touch devices, open them in the same
         tab instead: iOS Universal Links and Android App Links hand an
         m.me / facebook.com link to the Messenger or Facebook app most
         reliably from a same-tab tap, and a new tab often keeps people in
         the browser's web version. Without JS they keep the new tab. */
      if (window.matchMedia('(pointer: coarse)').matches) {
        document
          .querySelectorAll('a[href^="https://m.me/"], a[href*="facebook.com"]')
          .forEach((a) => a.removeAttribute('target'));
      }
    </script>
  </body>
</html>
