---
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  /** Page-specific OG image path; falls back to the site default. */
  ogImage?: string;
  /** Rendered into <head> as-is — JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
}

const { title, description, ogImage, schema = [] } = Astro.props as Props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage ?? site.seo.defaultOgImage, Astro.site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Open Graph — SPEC.md §7 ranks this highest: most traffic arrives from a
    shared Facebook link, so the preview card is the first impression. */}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={site.seo.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

{schema.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
