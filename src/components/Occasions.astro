---
import { Image } from 'astro:assets';
import IconBadge from './IconBadge.astro';
import type { IconName } from './IconBadge.astro';
import { img } from '../lib/images';
import gallery from '../data/gallery.json';

/* The occasion pool. Gallery tags in src/data/gallery.json use exactly
   these labels. Salo-salo is the everyday one: no special occasion, just
   a craving for lechon. */
const occasions: { label: string; icon: IconName }[] = [
  { label: 'Piyesta', icon: 'fan' },
  { label: 'Bagong Taon at Pasko', icon: 'star' },
  { label: 'Birthday', icon: 'cake' },
  { label: 'Reunion', icon: 'people' },
  { label: 'Salo-salo', icon: 'bowl' },
];

/* Occasion gallery: a mosaic of mounted photos, each with its occasion
   tag, from src/data/gallery.json (any number of photos). The mosaic runs
   sideways in groups of four — a large tile, a tall tile, two small —
   repeating for as many photos as there are; you swipe through it, or use
   the arrows on devices with a mouse. A photo with no occasion has no tag;
   in `astro dev` only it shows a dashed "Occasion?" placeholder. */
const items = gallery.items as { file: string; alt: string; occasion: string | null; focus?: string }[];
const showPlaceholders = import.meta.env.DEV;
const isLarge = (i: number) => i % 4 === 0;
---

<section class="occ">
  <div class="wrap section">
    <header class="shead">
      <p class="eyebrow eyebrow--on-dark">Para sa bawat okasyon</p>
      <h2 class="h2">The part people remember</h2>
    </header>
    <ul class="occ__list">
      {occasions.map((o) => (
        <li>
          <IconBadge name={o.icon} tone="on-dark" />
          <span>{o.label}</span>
        </li>
      ))}
    </ul>

    <div class="gal">
      <ul class="mosaic" id="occ-mosaic" role="list" tabindex="0" aria-label="Photos from our lechon orders">
        {items.map((s, i) => (
          <li class="tile">
            <Image
              src={img(s.file)}
              alt={s.alt}
              widths={isLarge(i) ? [480, 720, 960] : [320, 480, 640]}
              sizes={isLarge(i) ? '(min-width: 56em) 28rem, 85vw' : '(min-width: 56em) 14rem, 42vw'}
              format="webp"
              loading="lazy"
              class="tile__img"
              style={s.focus ? `object-position: ${s.focus}` : undefined}
            />
            {s.occasion ? (
              <span class="tile__tag">{s.occasion}</span>
            ) : (
              showPlaceholders && <span class="tile__tag tile__tag--todo" aria-hidden="true">Occasion?</span>
            )}
          </li>
        ))}
      </ul>
      <div class="gal__nav" hidden>
        <button class="gal__btn" type="button" data-dir="-1" aria-controls="occ-mosaic" aria-label="Previous photos">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6l6 6" /></svg>
        </button>
        <button class="gal__btn" type="button" data-dir="1" aria-controls="occ-mosaic" aria-label="Next photos">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6l-6 6" /></svg>
        </button>
      </div>
    </div>

    <p class="occ__p">
      Whatever you're celebrating, the lechon is what people remember. Book your date early —
      fiesta season and the holidays fill up fast.
    </p>
  </div>
</section>

<style>
  /* Registered so the edge fades can ease in and out (an unregistered
     custom property would jump). */
  @property --fade-l { syntax: '<length>'; inherits: false; initial-value: 0px; }
  @property --fade-r { syntax: '<length>'; inherits: false; initial-value: 0px; }

  .occ { background: var(--color-bg-inverse); color: var(--color-text-inverse); }

  /* Five occasions: wrapped rows, centred, so an odd count never leaves
     one hanging at the left — 3 + 2 on phones, one row of 5 on desktop. */
  .occ__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 0.5rem;
    list-style: none;
    max-width: 52rem;
    margin-inline: auto;
  }
  .occ__list li { flex: 0 0 6.75rem; }
  @media (min-width: 45em) { .occ__list li { flex-basis: 9rem; } }

  .occ__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }
  .occ__list li span:last-child {
    font-size: var(--text-sm);
    font-weight: 600;
    text-wrap: balance;
  }

  /* ---- Mosaic, running sideways ----
     Two rows; columns flow left to right. Every four photos make one
     group: a large tile (2 columns x 2 rows), a tall tile (1 x 2), then
     two small tiles stacked (1 x 1 each) — the same 2 : 1 : 1 mosaic as
     before, repeated for as many photos as gallery.json lists. Columns are
     a little narrower than a full group so the next one peeks in, which
     tells people there is more to swipe to.

     Phones: the strip bleeds to the screen edges; one column pair (the
     large tile, or tall + two small) fills the width, and swipes snap to
     each pair. Desktop: one whole group fills the 60rem frame, snapping
     per group, with arrow buttons below. */
  .gal { margin-top: var(--space-8); }
  .mosaic {
    --gap: var(--space-3);
    --row: 9.5rem;
    /* 100% is the strip's content box — the page's content width. */
    --col: calc((100% - var(--gap)) / 2 - 1rem);
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-template-rows: repeat(2, var(--row));
    grid-auto-columns: var(--col);
    gap: var(--gap);
    margin-inline: calc(-1 * var(--gutter));
    padding: 0.25rem var(--gutter) 1.25rem;
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* Edge fades, both sides: tiles slide in and out rather than being
       sliced. Each side fades only while there's more to scroll that way
       (the script sets data-start / data-end), easing in and out. */
    --fade: 1.5rem;
    --fade-l: 0px;
    --fade-r: var(--fade);
    -webkit-mask-image: linear-gradient(to right, transparent, black var(--fade-l), black calc(100% - var(--fade-r)), transparent);
    mask-image: linear-gradient(to right, transparent, black var(--fade-l), black calc(100% - var(--fade-r)), transparent);
    transition: --fade-l 200ms ease, --fade-r 200ms ease;
  }
  .mosaic[data-start='false'] { --fade-l: var(--fade); }
  .mosaic[data-end='true'] { --fade-r: 0px; }
  .mosaic::-webkit-scrollbar { display: none; }
  .mosaic:focus-visible { outline: 3px solid var(--color-focus); outline-offset: -3px; }

  .tile:nth-child(4n + 1) { grid-column: span 2; grid-row: span 2; scroll-snap-align: start; }
  .tile:nth-child(4n + 2) { grid-row: span 2; scroll-snap-align: start; }

  @media (min-width: 56em) {
    .gal { max-width: 60rem; margin-inline: auto; }
    .mosaic {
      --gap: var(--space-4);
      --row: 11.5rem;
      --col: calc((100% - 3 * var(--gap)) / 4 - 1.25rem);
      margin-inline: 0;
      padding-inline: 0;
      scroll-padding-inline: 0;
      --fade: 3.5rem;
    }
    .tile:nth-child(4n + 2) { scroll-snap-align: none; }
  }

  /* Arrows: only where there's a mouse to click them — phones swipe. */
  .gal__nav { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .gal__nav:not([hidden]) {
      display: flex;
      justify-content: center;
      gap: var(--space-3);
      margin-top: var(--space-2);
    }
  }
  .gal__btn {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: transparent;
    color: var(--color-text-inverse);
    cursor: pointer;
    transition: var(--transition);
  }
  .gal__btn:hover:not(:disabled) { background: rgb(255 255 255 / 0.12); }
  .gal__btn:disabled { opacity: 0.35; cursor: default; }
  .gal__btn svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Cream mount: food photos never sit directly on the red (DESIGN.md). */
  .tile {
    position: relative;
    min-width: 0;
    padding: 0.4rem;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.45);
  }
  .tile :global(.tile__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 4px);
  }

  /* Occasion tag, pinned to the photo's bottom-left. */
  .tile__tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-brand);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--shadow-card);
    max-width: calc(100% - 2rem);
  }
  .tile__tag--todo {
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    color: var(--color-text-muted);
    outline: 1.5px dashed var(--color-border-strong);
    outline-offset: -4px;
  }

  /* Centred under the centred icon row; short enough to read that way. */
  .occ__p {
    max-width: var(--prose-max);
    margin: var(--space-12) auto 0;
    text-align: center;
    opacity: 0.9;
    text-wrap: balance;
  }
</style>

<script>
  /* Arrow buttons for the gallery strip: scroll by one screenful of the
     strip, and disable each arrow at its end. Shown only if the strip
     actually overflows. Also flags whether the strip is at either end,
     which switches that edge's fade off. */
  const strip = document.querySelector<HTMLElement>('#occ-mosaic');
  const nav = document.querySelector<HTMLElement>('.gal__nav');
  if (strip && nav) {
    const [prev, next] = nav.querySelectorAll<HTMLButtonElement>('.gal__btn');
    const smooth = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
    const update = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      const atStart = strip.scrollLeft <= 1;
      const atEnd = strip.scrollLeft >= max - 1;
      nav.hidden = max <= 1;
      prev.disabled = atStart;
      next.disabled = atEnd;
      // Drive the edge fades (see .mosaic in the styles above).
      strip.dataset.start = String(atStart);
      strip.dataset.end = String(atEnd);
    };
    nav.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('.gal__btn');
      if (!btn) return;
      strip.scrollBy({ left: Number(btn.dataset.dir) * strip.clientWidth * 0.9, behavior: smooth ? 'smooth' : 'auto' });
    });
    strip.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>
