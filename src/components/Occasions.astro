---
import { Image } from 'astro:assets';
import IconBadge from './IconBadge.astro';
import type { IconName } from './IconBadge.astro';
import { img } from '../lib/images';
import gallery from '../data/gallery.json';

const occasions: { label: string; icon: IconName }[] = [
  { label: 'Birthdays', icon: 'cake' },
  { label: 'Fiesta', icon: 'fan' },
  { label: 'Reunions', icon: 'people' },
  { label: 'Binyag', icon: 'drop' },
  { label: 'Kasal', icon: 'rings' },
  { label: 'Pasko at Bagong Taon', icon: 'star' },
];

/* Occasion gallery: a mosaic of mounted photos, each tagged with the
   event it was taken at. Photos and tags come from src/data/gallery.json;
   a photo with no occasion simply has no tag. In `astro dev` only, an
   untagged photo shows a dashed "Occasion?" placeholder so the layout can
   be judged before real event photos exist; the built site never
   includes it, so no photo is ever labelled with an event it wasn't at. */
const items = gallery.items as { file: string; alt: string; occasion: string | null; focus?: string }[];
const shots = items.slice(0, 4);
const showPlaceholders = import.meta.env.DEV;
---

<section class="occ">
  <div class="wrap section">
    <header class="shead">
      <p class="eyebrow eyebrow--on-dark">Para sa bawat okasyon</p>
      <h2 class="h2">The part people remember</h2>
    </header>
    <ul class="occ__list">
      {occasions.map((o) => (
        <li>
          <IconBadge name={o.icon} tone="on-dark" />
          <span>{o.label}</span>
        </li>
      ))}
    </ul>

    <ul class="mosaic" role="list">
      {shots.map((s, i) => (
        <li class="tile">
          <Image
            src={img(s.file)}
            alt={s.alt}
            widths={i === 0 ? [480, 720, 960] : [320, 480, 640]}
            sizes={i === 0 ? '(min-width: 56em) 34rem, 92vw' : '(min-width: 56em) 17rem, 45vw'}
            format="webp"
            loading="lazy"
            class="tile__img"
            style={s.focus ? `object-position: ${s.focus}` : undefined}
          />
          {s.occasion ? (
            <span class="tile__tag">{s.occasion}</span>
          ) : (
            showPlaceholders && <span class="tile__tag tile__tag--todo" aria-hidden="true">Occasion?</span>
          )}
        </li>
      ))}
    </ul>

    <p class="occ__p">
      Whatever you're celebrating, the lechon is what people remember. Book your date early —
      fiesta season and the holidays fill up fast.
    </p>
  </div>
</section>

<style>
  .occ { background: var(--color-bg-inverse); color: var(--color-text-inverse); }

  .occ__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    list-style: none;
  }
  @media (min-width: 560px) { .occ__list { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 860px) { .occ__list { grid-template-columns: repeat(6, 1fr); } }

  .occ__list li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-align: center;
  }
  .occ__list li span:last-child {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  /* ---- Mosaic: four photos ----
     Phones: the lead photo full width, then a tall tile beside two small
     ones. Desktop: the lead photo large on the left, a tall tile in the
     middle, two small ones stacked on the right. The first four photos in
     gallery.json fill it, in order. */
  .mosaic {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 9.5rem;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .tile:first-child { grid-column: 1 / -1; grid-row: span 2; }
  .tile:nth-child(2) { grid-row: span 2; }
  @media (min-width: 56em) {
    .mosaic {
      grid-template-columns: 2fr 1fr 1fr;
      grid-auto-rows: 11.5rem;
      gap: var(--space-4);
      max-width: 60rem;
      margin-inline: auto;
    }
    .tile:first-child { grid-column: 1; }
  }

  /* Cream mount: food photos never sit directly on the red (DESIGN.md). */
  .tile {
    position: relative;
    padding: 0.4rem;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.45);
  }
  .tile :global(.tile__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: calc(var(--radius-lg) - 4px);
  }

  /* Occasion tag, pinned to the photo's bottom-left. */
  .tile__tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-bg);
    color: var(--color-brand);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: var(--shadow-card);
  }
  .tile__tag--todo {
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    color: var(--color-text-muted);
    outline: 1.5px dashed var(--color-border-strong);
    outline-offset: -4px;
  }

  /* Centred under the centred icon row; short enough to read that way. */
  .occ__p {
    max-width: var(--prose-max);
    margin: var(--space-12) auto 0;
    text-align: center;
    opacity: 0.9;
    text-wrap: balance;
  }
</style>
