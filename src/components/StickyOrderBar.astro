---
import site from '../data/site.json';
import { messengerFor } from '../lib/messenger';
---

<div class="orderbar">
  <p class="orderbar__txt">
    Order on Messenger<span>{site.ordering.leadTime}</span>
  </p>
  <a class="btn btn--onDark btn--sm" href={messengerFor('generic')}>Order</a>
</div>

<style>
  .orderbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 55;
    background: var(--color-bg-inverse-deep);
    padding: 0.6rem var(--gutter);
    padding-bottom: calc(0.6rem + env(safe-area-inset-bottom, 0px));
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-content: space-between;
    border-top: 1px solid rgb(255 255 255 / 0.14);
  }
  .orderbar__txt {
    color: var(--color-text-inverse);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.25;
  }
  .orderbar__txt span { display: block; opacity: 0.75; font-weight: var(--weight-normal); }

  @media (min-width: 720px) { .orderbar { display: none; } }
</style>
