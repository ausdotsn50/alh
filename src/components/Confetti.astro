---
/**
 * Confetti — scattered paper confetti, the closing CTA's ornament.
 * Banderitas belongs to the hero; the send-off gets this instead, so the
 * two ends of the page don't repeat each other. Purely decorative, so it
 * is hidden from assistive tech. Colours are the deco tokens only
 * (DESIGN.md).
 *
 * Place it as a DIRECT CHILD of the section it decorates. The host gets
 * position/clip from the :has() rule below; lift the host's content above
 * it (position: relative; z-index: 1).
 *
 * Pieces scatter evenly over the whole host. To keep them out from behind
 * text, pass `clear` and set two lengths on the host — the confetti fades
 * out inside that box:
 *   --confetti-clear-x  half the width of the clear box, from the centre
 *   --confetti-clear-y  how far in from the top and bottom it starts
 * Usually the host's content half-width and its padding-block. A share of
 * the pieces is pinned within 2rem of the top and bottom edges instead, so
 * narrow screens, whose side margins are too thin to show any, still get
 * confetti in the padding. Phones get their own, sparser set. Positions come from a seeded generator, so every
 * build scatters them the same way.
 */
interface Props {
  /** Ground the confetti sits on. `dark` swaps red-orange for cream,
   *  which otherwise disappears against the red. */
  tone?: 'dark' | 'light';
  /** Pieces at desktop width; phones get half as many. */
  count?: number;
  /** Change for a different scatter. */
  seed?: number;
  /** Fade out inside the host's --confetti-clear-x / -y box. */
  clear?: boolean;
}
const { tone = 'dark', count = 70, seed = 7, clear = false } = Astro.props as Props;

const palette = tone === 'dark' ? ['deco-1', 'deco-4', 'deco-3'] : ['deco-2', 'deco-1', 'deco-3'];

type Shape = 'strip' | 'square' | 'dot' | 'curl';
interface Piece { x: number; y: string; r: number; s: number; d: number; c: string; shape: Shape }

/* mulberry32: small, fast, deterministic. */
function rng(a: number) {
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const r1 = (n: number) => Math.round(n * 10) / 10;
const shapes: Shape[] = ['strip', 'strip', 'strip', 'dot', 'dot', 'square', 'curl', 'curl'];
const rand = rng(seed);

/** `edgeShare` of the pieces go in a band 0.9–2.2rem in from the top or
 *  bottom edge; the rest anywhere. Every piece stays at least ~0.9rem
 *  (and 3% of the width) inside the host, so none is cut in half by its
 *  edge. `y` is a ready-made top/bottom declaration. */
const scatter = (n: number, edgeShare: number): Piece[] =>
  Array.from({ length: n }, () => ({
    x: r1(3 + rand() * 94),
    y: rand() < edgeShare
      ? `${rand() < 0.5 ? 'top' : 'bottom'}:${r1(0.9 + rand() * 1.3)}rem`
      : `top:${r1(5 + rand() * 90)}%`,
    r: Math.round(rand() * 360),
    s: r1(0.8 + rand() * 0.6),
    d: Math.round(30 + rand() * 60),
    c: `var(--color-${palette[Math.floor(rand() * palette.length)]})`,
    shape: shapes[Math.floor(rand() * shapes.length)],
  }));

const sets = [
  { cls: 'confetti__p--wide', pieces: scatter(count, 0.3) },
  /* Phones: side margins are only the 16px gutter, so every piece goes
     in the top and bottom padding bands — none left stranded at the edge. */
  { cls: 'confetti__p--narrow', pieces: scatter(Math.round(count * 0.5), 1) },
];
---

<div class:list={['confetti', clear && 'confetti--clear']} aria-hidden="true">
  {sets.flatMap((set) =>
    set.pieces.map((p) => (
      <span
        class:list={['confetti__p', `confetti__p--${p.shape}`, set.cls]}
        style={`left:${p.x}%;${p.y};--r:${p.r}deg;--s:${p.s};--d:${p.d}px;--c:${p.c}`}
      >
        {p.shape === 'curl' && (
          <svg viewBox="0 0 22 10" focusable="false">
            <path d="M1.5 6.5c2.5-5 5-5 6.5 0s4 5 6.5 0 4-5 6 0" />
          </svg>
        )}
      </span>
    ))
  )}
</div>

<style>
  /* ---- host contract ---- */
  :global(:has(> .confetti)) {
    position: relative;
    overflow: clip;
  }

  .confetti {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  /* Two mask layers, unioned: the side margins, and the top and bottom
     strips. Anything in neither — the content box — fades out over --f
     rather than being cut. Mask colours are alpha only. */
  .confetti--clear {
    --cx: var(--confetti-clear-x);
    --cy: var(--confetti-clear-y);
    --f: 0.5rem;
    -webkit-mask-image:
      linear-gradient(to right, black calc(50% - var(--cx) - var(--f)), transparent calc(50% - var(--cx)), transparent calc(50% + var(--cx)), black calc(50% + var(--cx) + var(--f))),
      linear-gradient(to bottom, black calc(var(--cy) - var(--f)), transparent var(--cy), transparent calc(100% - var(--cy)), black calc(100% - var(--cy) + var(--f)));
    mask-image:
      linear-gradient(to right, black calc(50% - var(--cx) - var(--f)), transparent calc(50% - var(--cx)), transparent calc(50% + var(--cx)), black calc(50% + var(--cx) + var(--f))),
      linear-gradient(to bottom, black calc(var(--cy) - var(--f)), transparent var(--cy), transparent calc(100% - var(--cy)), black calc(100% - var(--cy) + var(--f)));
  }

  .confetti__p {
    position: absolute;
    display: block;
    background: var(--c);
    transform: translate(-50%, -50%) rotate(var(--r)) scale(var(--s));
  }
  .confetti__p--strip  { width: 5px; height: 14px; border-radius: 1.5px; }
  .confetti__p--square { width: 8px; height: 8px; border-radius: 1px; }
  .confetti__p--dot    { width: 7px; height: 7px; border-radius: 50%; }
  .confetti__p--curl   { width: 22px; height: 10px; background: none; }
  .confetti__p svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--c);
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .confetti__p--wide { display: none; }
  @media (min-width: 48em) {
    .confetti__p--wide { display: block; }
    .confetti__p--narrow { display: none; }
  }

  /* Each piece drifts down into place as the section scrolls into view,
     then stays put. Scroll-driven, so no JS; browsers without it simply
     show the confetti at rest. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .confetti__p {
        animation: confetti-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }
  @keyframes confetti-drift {
    from { translate: 0 calc(var(--d) * -1); rotate: -50deg; }
    to   { translate: 0 0; rotate: 0deg; }
  }
</style>
